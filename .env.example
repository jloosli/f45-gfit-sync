GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Two separate tokens: the Health API rejects any token that also carries Gmail
# scopes. Mint with `uv run get_refresh_token.py gmail` / `... health`.
GOOGLE_REFRESH_TOKEN_GMAIL=
GOOGLE_REFRESH_TOKEN_HEALTH=
LOCAL_TIMEZONE=America/Denver
EXERCISE_TYPE=HIIT
# DRY_RUN=1
